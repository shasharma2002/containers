# --- tracking output -------------------------------------------------------
# Regenerated by every run, and the appended history gets large. Keep it out of
# version control, but do NOT delete it casually: the reporting layer detects
# delays by comparing a container's ETA between snapshots, so the history IS
# the delay baseline.
containers.json
events.json
errors.json
shipments.json
out/

# --- generated report ------------------------------------------------------
output/

# --- browser profile -------------------------------------------------------
# Persistent Chromium profile for maersk_browser.py (~58 MB). Regenerable, but
# keeping it between runs makes Maersk's bot protection less likely to
# challenge us, so do not delete it as routine cleanup.
.maersk-profile/

# --- archives --------------------------------------------------------------
.archive/

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- editor / OS -----------------------------------------------------------
.ipynb_checkpoints/
.vscode/
.idea/
Thumbs.db
desktop.ini
~$*.xlsx
